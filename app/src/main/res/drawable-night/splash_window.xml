<?xml version="1.0" encoding="utf-8"?>
<!--
  深色（系统夜间模式）的窗口背景，结构与 drawable/splash_window.xml 完全一致。

  与浅色那份一样只铺底色：这里留着 logo 的话，深色下的第二屏和首屏会各画一遍，
  位置随 density 漂移。深色的 logo 由 SplashBrandLayer 按同一套 dp 画，
  @drawable/ic_splash_lockup 在夜间模式下自然解析到 drawable-night-nodpi。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/splash_background" />
    </item>
</layer-list>
