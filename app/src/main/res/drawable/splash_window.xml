<?xml version="1.0" encoding="utf-8"?>
<!--
  窗口背景：只铺底色，不放 logo。

  品牌元素（logo 与开屏动画）全部由 Compose 的第二屏（SplashBrandLayer）画，
  这里再画一遍会有两条渲染路径：layer-list 的 <bitmap> 和 Compose 的 BitmapPainter
  对 nodpi 位图的 density 处理不同，位置与尺寸永远对不齐。只留底色就没有对齐问题——
  系统启动屏退场、第二屏接上的那一刻，画面里唯一的变量是 logo 淡入。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/splash_background" />
    </item>
</layer-list>
